<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>MetaSheet-Guard validation report</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 2rem; color: #1f2933; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #d9e2ec; padding: 0.5rem; text-align: left; vertical-align: top; }
    th { background: #f0f4f8; }
    .error { color: #b42318; font-weight: 700; }
    .warning { color: #92400e; font-weight: 700; }
    .info { color: #1d4ed8; font-weight: 700; }
  </style>
</head>
<body>
  <h1>MetaSheet-Guard validation report</h1>

  <h2>Project summary</h2>
  <table>
    <tbody>
    {% for key, value in report.summary.items() %}
      <tr><th>{{ key }}</th><td>{{ value }}</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Export readiness</h2>
  <table>
    <thead><tr><th>Target</th><th>Ready</th></tr></thead>
    <tbody>
    {% for target, ready in report.export_readiness.items() %}
      <tr><td>{{ target }}</td><td>{{ ready }}</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Issues</h2>
  <table>
    <thead>
      <tr>
        <th>Severity</th>
        <th>Code</th>
        <th>Message</th>
        <th>Location</th>
        <th>Suggestion</th>
      </tr>
    </thead>
    <tbody>
    {% for issue in report.issues %}
      <tr>
        <td class="{{ issue.severity }}">{{ issue.severity }}</td>
        <td>{{ issue.code }}</td>
        <td>{{ issue.message }}</td>
        <td>
          {% if issue.row %}row {{ issue.row }}{% endif %}
          {% if issue.column %} column {{ issue.column }}{% endif %}
          {% if issue.sample_id %} sample {{ issue.sample_id }}{% endif %}
          {% if issue.file_path %} file {{ issue.file_path }}{% endif %}
        </td>
        <td>{{ issue.suggestion or "" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</body>
</html>
